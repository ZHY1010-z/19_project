## 3. CODEGRAPH MCP Server

### Purpose
Dependency graph generation and call flow analysis for understanding legacy system architecture

### Core Functionality
- Dependency graph visualization
- Call graph generation
- Data flow analysis
- Circular dependency detection
- Impact analysis for changes

### API Design

#### Tools Available:
```typescript
interface CodeGraphTools {
  // Graph Generation
  buildDependencyGraph(repoPath: string): DependencyGraph;
  generateCallGraph(entryPoints: string[]): CallGraph;
  analyzeDataFlow(startFunction: string): DataFlowGraph;
  
  // Analysis Operations
  findCircularDependencies(graph: DependencyGraph): CircularDependency[];
  analyzeImpact(changedFiles: string[]): ImpactAnalysis;
  getModuleCoupling(modulePath: string): CouplingMetrics;
  
  // Visualization
  exportGraph(graph: Graph, format: 'dot' | 'json' | 'svg'): string;
  getSubgraph(graph: Graph, nodeId: string, depth: number): Graph;
}
```

#### Data Structures:
```typescript
interface DependencyGraph {
  nodes: DependencyNode[];
  edges: DependencyEdge[];
  metadata: GraphMetadata;
}

interface DependencyNode {
  id: string;
  name: string;
  type: NodeType;
  filePath: string;
  metrics: NodeMetrics;
}

interface DependencyEdge {
  from: string;
  to: string;
  type: EdgeType;
  weight: number;
  location: Location;
}

interface CallGraph {
  functions: FunctionNode[];
  calls: CallEdge[];
  entryPoints: string[];
}

interface CircularDependency {
  cycle: string[];
  severity: 'low' | 'medium' | 'high';
  suggestions: string[];
}
```

